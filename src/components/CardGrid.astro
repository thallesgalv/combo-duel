---
import { existsSync } from "node:fs";
import Card from "./Card.astro";
import { locations, monsterTypes, shieldColors, shieldInfo, typeIcon } from "../lib/monsterTypes";
import { csvMapping, getCards } from "../lib/cards";
import { richText } from "../lib/richText";
import star from "../../assets/frame/star.png";
import puzzle from "../../assets/icons/millenium-puzzle.png";
import castleCard from "../../assets/icons/card-castle.svg?url";
import villageCard from "../../assets/icons/card-village.svg?url";
import gauntlet from "../../assets/icons/gauntlet.png";

interface Props {
  // Painel da página inicial: distribuição por tipo e filtro por tipo
  lab?: boolean;
}

const { lab = false } = Astro.props;
const cards = getCards();
// Escudos citados nos textos ([red] etc.)
const mentions = (text: string) => [...new Set([...text.matchAll(/\[([a-z]+)\]/g)].map((m) => m[1]))];
// Dados para o script do painel
const labData = {
  csv: csvMapping,
  colors: shieldColors,
  types: Object.fromEntries(
    Object.entries(monsterTypes).map(([type, { label }]) => [type, { label, icon: typeIcon(type as keyof typeof monsterTypes) }]),
  ),
};
// PNGs só existem depois de `npm run cards -- --public`
const hasPng = (fileName: string) => existsSync(`public/cards/${fileName}`);
// Texto pesquisável: nome Yu-Gi-Oh + nome original do Castle Combo, sem acentos e em minúsculas
const searchText = (...names: string[]) =>
  names.join(" ").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
// Custos que existem nas cartas, em ordem (filtro do painel)
const costs = [...new Set(cards.map((c) => c.cost))].sort((a, b) => a - b);
---

{
  lab && (
    <section class="lab not-content" data-lab={JSON.stringify(labData)}>
      <details open>
        <summary>Distribuição por tipo</summary>
        <div class="lab-table-wrap">
          <table class="lab-table">
            <thead>
              <tr>
                <th>Tipo</th>
                <th>Escudo</th>
                <th title="Cartas com esse tipo">Cartas</th>
                <th>Dourado</th>
                <th>Preto</th>
                <th title="Cartas com dois escudos que incluem esse tipo">Duplas</th>
                <th title="Cartas que citam esse tipo no efeito ou na pontuação">Citado em</th>
                <th>Custo médio</th>
              </tr>
            </thead>
            <tbody />
          </table>
        </div>
      </details>

      <div class="lab-filter" role="group" aria-label="Filtrar por tipo">
        <button type="button" class="lab-chip" data-filter="" aria-pressed="true">Todos</button>
        {Object.entries(monsterTypes).map(([type, { label }]) => (
          <button type="button" class="lab-chip" data-filter={type} aria-pressed="false">
            {typeIcon(type as keyof typeof monsterTypes) && <img src={typeIcon(type as keyof typeof monsterTypes)} alt="" />}
            {label}
          </button>
        ))}
        <span class="lab-sep" aria-hidden="true" />
        {/* Baralho: combina com o filtro de tipo; clicar de novo desmarca */}
        {(["castle", "village"] as const).map((location) => (
          <button
            type="button"
            class="lab-chip lab-chip-deck"
            data-deck={location}
            aria-pressed="false"
            aria-label={locations[location].label}
            title={locations[location].label}
          >
            <img src={location === "castle" ? castleCard : villageCard} alt="" />
          </button>
        ))}
        <span class="lab-sep" aria-hidden="true" />
        {/* Selos: cada um liga/desliga sozinho e combina com os outros filtros */}
        <button type="button" class="lab-chip lab-chip-deck" data-flag="messenger" aria-pressed="false" title="Move o enigma do milênio">
          <img src={puzzle.src} alt="" />
          Enigma
        </button>
        <button type="button" class="lab-chip lab-chip-deck" data-flag="purse" aria-pressed="false" title="Tem manopla">
          <img src={gauntlet.src} alt="" />
          Manopla
        </button>
        <span class="lab-sep" aria-hidden="true" />
        {/* Custo: um por vez, clicar de novo desmarca */}
        {costs.map((cost) => (
          <button type="button" class="lab-chip lab-chip-cost" data-cost-filter={cost} aria-pressed="false" title={`Custo ${cost}`}>
            {cost}
            <img src={star.src} alt="estrela" />
          </button>
        ))}
        <label class="lab-mentions">
          <input type="checkbox" data-mentions /> sinergia com o tipo selecionado
        </label>
      </div>
    </section>
  )
}

<div class="card-search not-content">
  <input
    type="search"
    class="card-search-input"
    placeholder="Buscar carta (Yu-Gi-Oh ou Castle Combo)"
    aria-label="Buscar carta pelo nome Yu-Gi-Oh ou Castle Combo"
    autocomplete="off"
    spellcheck="false"
  />
</div>

<p class="card-grid-count not-content">{cards.length} cartas</p>

<div class="card-grid not-content">
  {
    cards.map((card) => (
      <figure
        data-shields={card.shields.join(" ")}
        data-mentions={mentions(`${card.ability} ${card.score}`).join(" ")}
        data-location={card.location}
        data-messenger={String(card.moveMessenger)}
        data-purse={String(card.purse)}
        data-cost={card.cost}
        data-id={card.id}
        data-search={searchText(card.name, card.originalName)}
      >
        <button type="button" class="card-open" aria-label={`Ver ${card.name} em tamanho grande`}>
          <Card card={card} />
        </button>
        {/* Informações exibidas ao lado da carta no modal */}
        <template class="card-info">
          <h2 class="card-modal-name">{card.name}</h2>
          <dl class="card-modal-stats">
            <div>
              <dt>Custo</dt>
              <dd class="card-modal-cost">
                {card.cost}
                <img src={star.src} alt="estrela" />
              </dd>
            </div>
            <div>
              <dt>Tipos</dt>
              {/* Um ícone grande; dois tipos lado a lado, menores */}
              <dd class:list={["card-modal-attrs", { "card-modal-attrs-two": card.shields.length > 1 }]}>
                {card.shields.map(shieldInfo).map((type) =>
                  type.icon ? (
                    <img class="card-modal-type" src={type.icon} alt={type.label} title={type.label} />
                  ) : (
                    <span class="attr" style={`--attr: ${type.color}`}>
                      {type.label.toUpperCase()}
                    </span>
                  ),
                )}
              </dd>
            </div>
            <div>
              <dt>Troca</dt>
              {/* Mesmo enigma da carta */}
              <dd>
                {card.moveMessenger ? (
                  <img
                    class="card-modal-messenger"
                    src={puzzle.src}
                    alt="Mova o enigma do milênio"
                    title="Mova o enigma do milênio"
                  />
                ) : (
                  "—"
                )}
              </dd>
            </div>
            <div>
              <dt>Deck</dt>
              <dd class="card-modal-deck">
                <img
                  src={card.location === "castle" ? castleCard : villageCard}
                  alt={locations[card.location].label}
                  title={locations[card.location].label}
                />
              </dd>
            </div>
          </dl>
          <section>
            <h3>Efeito</h3>
            <p set:html={richText(card.ability)} />
          </section>
          <section>
            <h3>Pontuação</h3>
            <p set:html={richText(card.score)} />
          </section>
          <section class="card-modal-faq">
            <h3>Carta original · {card.originalName}</h3>
            <ul>
              <li>{card.originalAbility}</li>
              <li>{card.originalScore}</li>
            </ul>
            {card.originalSrc && (
              <img class="card-modal-original" src={card.originalSrc} alt={card.originalName} loading="lazy" />
            )}
          </section>
        </template>
        {hasPng(card.fileName) && (
          <a href={`${import.meta.env.BASE_URL}/cards/${card.fileName}`} download>
            PNG
          </a>
        )}
      </figure>
    ))
  }
</div>

<dialog class="card-modal not-content" aria-label="Carta em tamanho grande">
  <button type="button" class="card-modal-close" aria-label="Fechar">×</button>
  <div class="card-modal-body">
    <div class="card-modal-card">
      <div class="card-modal-tilt">
        <div class="card-modal-slot"></div>
        <div class="card-modal-glare"></div>
      </div>
    </div>
    <div class="card-modal-info"></div>
  </div>
</dialog>

<script>
  const figures = [...document.querySelectorAll<HTMLElement>(".card-grid figure")];
  const count = document.querySelector<HTMLElement>(".card-grid-count")!;
  const searchInput = document.querySelector<HTMLInputElement>(".card-search-input")!;
  const normalize = (text: string) =>
    text.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
  // Filtro do painel (tipo/baralho); sem painel, aceita tudo
  let labMatches: (f: HTMLElement) => boolean = () => true;
  let labActive = () => false;
  let afterFilter = () => {};
  let resetLab = () => {};

  // Busca + painel: todos os termos digitados precisam aparecer no nome YGO ou no Castle Combo
  const applyFilter = () => {
    const terms = normalize(searchInput.value).split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const f of figures) {
      const ok = labMatches(f) && terms.every((t) => f.dataset.search!.includes(t));
      f.hidden = !ok;
      shown += +ok;
    }
    count.textContent =
      terms.length || labActive() ? `${shown} de ${figures.length} cartas` : `${figures.length} cartas`;
    afterFilter();
  };

  // Ao digitar, o painel volta para "Todos" para a busca valer sobre todas as cartas
  searchInput.addEventListener("input", () => {
    if (searchInput.value.trim()) resetLab();
    applyFilter();
  });
  // Mantém o filtro se o navegador restaurar o texto (voltar/avançar)
  if (searchInput.value) applyFilter();

  // Painel da página inicial: distribuição por tipo e filtro por tipo
  const lab = document.querySelector<HTMLElement>(".lab");
  if (lab) {
    type Info = { label: string; icon?: string };
    const data = JSON.parse(lab.dataset.lab!) as {
      // Escudo → tipo (base/csv/vigentTypeColorShieldMapping.csv)
      csv: Record<string, string>;
      colors: Record<string, string>;
      types: Record<string, Info>;
    };
    const map = data.csv;
    const chips = [...lab.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const deckChips = [...lab.querySelectorAll<HTMLButtonElement>("[data-deck]")];
    const costChips = [...lab.querySelectorAll<HTMLButtonElement>("[data-cost-filter]")];
    let cost = "";
    const flagChips = [...lab.querySelectorAll<HTMLButtonElement>("[data-flag]")];
    const flags = new Set<string>();
    const mentionsBox = lab.querySelector<HTMLInputElement>("[data-mentions]")!;
    let filter = "";
    let deck = "";

    const typesOf = (shields: string) => shields.split(" ").filter(Boolean).map((sh) => map[sh]);

    const renderTable = () => {
      const rows = Object.entries(data.types).map(([type, info]) => {
        const has = figures.filter((f) => typesOf(f.dataset.shields!).includes(type));
        const cited = figures.filter((f) => typesOf(f.dataset.mentions!).includes(type));
        const shields = Object.keys(map).filter((sh) => map[sh] === type);
        const avg = has.length ? has.reduce((n, f) => n + Number(f.dataset.cost), 0) / has.length : 0;
        return { info, has, cited, shields, avg };
      });
      const max = Math.max(...rows.map((r) => r.has.length), 1);
      lab.querySelector(".lab-table tbody")!.innerHTML = rows
        .map(
          (r) => `<tr>
            <td class="lab-type">${r.info.icon ? `<img src="${r.info.icon}" alt="">` : ""}${r.info.label}</td>
            <td>${r.shields.map((sh) => `<span class="lab-dot" style="--dot: ${data.colors[sh]}" title="${sh}"></span>`).join("") || "—"}</td>
            <td><span class="lab-bar" style="--w: ${(r.has.length / max) * 100}%"></span><strong>${r.has.length}</strong></td>
            <td>${r.has.filter((f) => f.dataset.location === "castle").length}</td>
            <td>${r.has.filter((f) => f.dataset.location === "village").length}</td>
            <td>${r.has.filter((f) => f.dataset.shields!.includes(" ")).length}</td>
            <td>${r.cited.length}</td>
            <td>${r.has.length ? r.avg.toFixed(1) : "—"}</td>
          </tr>`,
        )
        .join("");
    };

    labMatches = (f) =>
      (!deck || f.dataset.location === deck) &&
      (!cost || f.dataset.cost === cost) &&
      [...flags].every((flag) => f.dataset[flag] === "true") &&
      (!filter ||
        typesOf(f.dataset.shields!).includes(filter) ||
        (mentionsBox.checked && typesOf(f.dataset.mentions!).includes(filter)));
    labActive = () => Boolean(filter || deck || cost || flags.size);
    resetLab = () => {
      filter = "";
      deck = "";
      cost = "";
      flags.clear();
    };
    afterFilter = () => {
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.filter === filter)));
      deckChips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.deck === deck)));
      costChips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.costFilter === cost)));
      flagChips.forEach((c) => c.setAttribute("aria-pressed", String(flags.has(c.dataset.flag!))));
    };

    chips.forEach((c) =>
      c.addEventListener("click", () => {
        filter = filter === c.dataset.filter ? "" : c.dataset.filter!;
        applyFilter();
      }),
    );
    deckChips.forEach((c) =>
      c.addEventListener("click", () => {
        deck = deck === c.dataset.deck ? "" : c.dataset.deck!;
        applyFilter();
      }),
    );
    costChips.forEach((c) =>
      c.addEventListener("click", () => {
        cost = cost === c.dataset.costFilter ? "" : c.dataset.costFilter!;
        applyFilter();
      }),
    );
    flagChips.forEach((c) =>
      c.addEventListener("click", () => {
        const flag = c.dataset.flag!;
        if (!flags.delete(flag)) flags.add(flag);
        applyFilter();
      }),
    );
    mentionsBox.addEventListener("change", applyFilter);
    renderTable();
  }

  const modal = document.querySelector<HTMLDialogElement>(".card-modal");
  if (modal) {
    const cardSlot = modal.querySelector<HTMLElement>(".card-modal-slot")!;
    const tilt = modal.querySelector<HTMLElement>(".card-modal-tilt")!;
    const infoSlot = modal.querySelector<HTMLElement>(".card-modal-info")!;
    // Tamanho de impressão da carta (ver lib/cards.ts)
    const CARD_W = 744;
    const CARD_H = 1039;

    // Ocupa a maior parte da tela: lado a lado no desktop, empilhado no celular
    const fitCard = () => {
      const card = cardSlot.querySelector<HTMLElement>(".card");
      if (!card) return;
      const wide = window.innerWidth >= 800;
      const maxW = wide ? window.innerWidth * 0.45 : window.innerWidth * 0.82;
      const maxH = wide ? window.innerHeight * 0.85 : window.innerHeight * 0.62;
      card.style.zoom = String(Math.min(maxW / CARD_W, maxH / CARD_H));
    };

    document.querySelectorAll<HTMLButtonElement>(".card-open").forEach((button) => {
      button.addEventListener("click", () => {
        const figure = button.closest("figure")!;
        cardSlot.replaceChildren(button.querySelector(".card")!.cloneNode(true));
        infoSlot.replaceChildren(figure.querySelector<HTMLTemplateElement>(".card-info")!.content.cloneNode(true));
        fitCard();
        modal.showModal();
      });
    });

    window.addEventListener("resize", fitCard);

    // Perspectiva só no desktop (mouse) e sem preferência por menos movimento
    const canTilt = window.matchMedia("(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)");
    const MAX_TILT = 10;
    tilt.addEventListener("pointermove", (event) => {
      if (!canTilt.matches) return;
      const rect = tilt.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width;
      const y = (event.clientY - rect.top) / rect.height;
      tilt.classList.add("is-tilting");
      tilt.style.transform = `rotateX(${(0.5 - y) * 2 * MAX_TILT}deg) rotateY(${(x - 0.5) * 2 * MAX_TILT}deg) scale(1.02)`;
      tilt.style.setProperty("--glare-x", `${x * 100}%`);
      tilt.style.setProperty("--glare-y", `${y * 100}%`);
    });
    tilt.addEventListener("pointerleave", () => {
      tilt.classList.remove("is-tilting");
      tilt.style.transform = "";
    });
    modal.querySelector(".card-modal-close")!.addEventListener("click", () => modal.close());
    // Clique fora do conteúdo (no fundo desfocado) fecha
    modal.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });
  }
</script>

<style>
  .card-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }

  figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin: 0;
  }

  /* A carta é desenhada em pixels de impressão; no wiki mostramos em escala reduzida */
  figure :global(.card) {
    zoom: 0.35;
  }

  figure a {
    font-size: 0.8rem;
  }

  .card-open {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 8px;
  }

  .card-open:focus-visible {
    outline: 3px solid var(--sl-color-accent);
    outline-offset: 4px;
  }

  /* Hover só em dispositivos com mouse: leve aumento com transição suave */
  @media (hover: hover) {
    .card-open {
      transition: transform 0.25s ease, filter 0.25s ease;
    }

    /* Por cima das cartas vizinhas enquanto aumentada */
    .card-open:hover {
      position: relative;
      z-index: 1;
      transform: scale(1.06);
      filter: drop-shadow(0 10px 18px rgb(0 0 0 / 0.3));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-open {
      transition: none;
    }
  }

  .card-modal {
    width: min(1100px, 94vw);
    max-width: none;
    max-height: 94vh;
    box-sizing: border-box;
    /* O reset do Starlight zera a margem que centraliza o <dialog> */
    margin: auto;
    overflow: auto;
    padding: 32px;
    border: 0;
    border-radius: 20px;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.4);
  }

  .card-modal[open] {
    animation: card-modal-in 0.25s ease;
  }

  /* Fundo da página desfocado atrás do modal */
  .card-modal::backdrop {
    background: rgb(0 0 0 / 0.35);
    backdrop-filter: blur(8px);
  }

  @keyframes card-modal-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-modal[open] {
      animation: none;
    }
  }

  .card-modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }

  .card-modal-body {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .card-modal-card {
    flex: none;
    perspective: 1200px;
  }

  .card-modal-tilt {
    position: relative;
    border-radius: 24px;
    transform-style: preserve-3d;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  /* Segue o mouse de perto enquanto inclina; volta devagar ao sair */
  .card-modal-tilt.is-tilting {
    transition: transform 0.08s linear;
  }

  /* Reflexo de luz que acompanha o mouse */
  .card-modal-glare {
    position: absolute;
    inset: 0;
    border-radius: 24px;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle at var(--glare-x, 50%) var(--glare-y, 50%), rgb(255 255 255 / 0.35), transparent 55%);
    mix-blend-mode: soft-light;
    transition: opacity 0.3s ease;
  }

  .is-tilting .card-modal-glare {
    opacity: 1;
  }

  .card-modal-card :global(.card) {
    border-radius: 24px;
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.3);
  }

  .card-modal-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .card-modal-info :global(.card-modal-name) {
    margin: 0;
    font-size: 2.4rem;
    line-height: 1.1;
    color: var(--sl-color-white);
  }

  .card-modal-info :global(.card-modal-stats) {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .card-modal-info :global(.card-modal-stats div) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--sl-color-gray-6);
    text-align: center;
  }

  .card-modal-info :global(.card-modal-stats dd) {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .card-modal-info :global(.card-modal-cost img) {
    width: 30px;
    height: 30px;
  }

  .card-modal-info :global(.card-modal-messenger) {
    width: auto;
    height: 34px;
  }

  .card-modal-info :global(.card-modal-deck img) {
    height: 40px;
  }

  .card-modal-info :global(dt) {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .card-modal-info :global(dd) {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--sl-color-white);
    font-variant-numeric: tabular-nums;
  }

  .card-modal-info :global(h3) {
    margin: 0 0 4px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .card-modal-info :global(section p) {
    margin: 0;
  }

  .card-modal-info :global(.card-modal-faq) {
    padding: 14px 18px;
    border-radius: 10px;
    background: var(--sl-color-gray-6);
    font-size: 0.95rem;
  }

  .card-modal-info :global(.card-modal-faq ul) {
    margin: 0;
    padding-left: 1.2em;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Tema escuro: setas de linha/coluna em branco no texto do modal (fora da carta) */
  :global(:root[data-theme="dark"]) .card-modal-info :global(.rt-dir) {
    filter: brightness(0) invert(1);
  }

  :global(:root[data-theme="dark"]) .card-modal-info :global(.rt-around) {
    --ink: #fff;
  }

  .card-modal-info :global(.card-modal-original) {
    display: block;
