---
import star from "../../assets/frame/star.png";
import { shieldInfo } from "../lib/monsterTypes";
import { cardSizeVars, type CardView } from "../lib/cards";
import { richText } from "../lib/richText";
import "../styles/card.css";

interface Props {
  card: CardView;
  bleed?: boolean;
}

// Layout inspirado nas cartas do anime (template do AYGOCM em assets/frame/):
// arte grande, estrelas = custo, ícones de tipo (DG) empilhados no canto superior direito,
// e no painel de monstro normal as caixas de efeito e pontuação empilhadas.
const { card, bleed = false } = Astro.props;
const types = card.shields.map(shieldInfo);
// Mensageiro: Baralho Dourado (castle) ▼ preto, Baralho Preto (village) ▲ dourado
const castle = card.location === "castle";
// Caixas de texto; com **OU** ou **E** a caixa se divide em duas partes separadas por uma
// diagonal, com a conjunção num selo no meio
const capitalize = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const boxes = [
  { label: "Efeito", text: card.ability, cls: "card-ability" },
  { label: "Pontuação", text: card.score, cls: "card-score" },
].map((box) => {
  const split = box.text.match(/^(.*?)\s*\*\*(OU|E)\*\*\s*(.*)$/);
  return { ...box, split: split && { left: capitalize(split[1]), joiner: split[2], right: capitalize(split[3]) } };
});
---

<article class={`card card-frame-${card.boxColor}`} style={cardSizeVars(bleed)} data-card-id={card.id}>
  <div class="card-face">
    <div class="card-art-frame">
      {
        card.artSrc ? (
          <img class="card-art" src={card.artSrc} alt={card.name} />
        ) : (
          <div class="card-art-missing">
            sem arte
            <br />
            assets/artworks/{card.artFile}
          </div>
        )
      }
    </div>

    <div class="card-types">
      {
        types.map((type) => (
          <span class="card-type" style={`--type: ${type.color}`} title={type.label}>
            {type.icon ? <img src={type.icon} alt={type.label} /> : type.label}
          </span>
        ))
      }
    </div>

    {
      card.moveMessenger && (
        <svg
          class:list={["card-messenger", castle ? "card-messenger-castle" : "card-messenger-village"]}
          viewBox="0 0 100 100"
          role="img"
          aria-label="Mova o mensageiro"
        >
          <title>Mova o mensageiro</title>
          <polygon points={castle ? "6,12 94,12 50,92" : "50,8 94,88 6,88"} />
        </svg>
      )
    }

    {
      card.cost > 0 && (
        <div class="card-stars" title={`Custo ${card.cost}`}>
          {Array.from({ length: card.cost }, () => (
            <img src={star.src} alt="" />
          ))}
        </div>
      )
    }

    <div class="card-panel">
      {
        boxes.map((box) => (
          <div class:list={["card-box", box.cls, { "card-box-or": box.split }]}>
            <span class="card-label">{box.label}</span>
            {box.split ? (
              <>
                <p set:html={richText(box.split.left)} />
                <span class="card-or-clip" aria-hidden="true">
                  <span class="card-or-line" />
                </span>
                <span class="card-or">{box.split.joiner}</span>
                <p set:html={richText(box.split.right)} />
              </>
            ) : (
              <p set:html={richText(box.text)} />
            )}
          </div>
        ))
      }
    </div>
  </div>
</article>
