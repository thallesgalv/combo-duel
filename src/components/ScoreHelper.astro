---
// Auxiliar de contagem de pontos: campo 3×3, cada carta abre um modal para lançar os pontos
// (valor direto ou "N pontos por X"). Embaixo, as fichas do milênio que sobraram e o total.
// Guarda o estado no localStorage do navegador (só conveniência: sem ele, funciona igual).
import starchip from "../../assets/icons/starchip.svg?url";
import key from "../../assets/icons/key.png";
---

<section class="score not-content" data-starchip={starchip}>
  <div class="score-grid" role="grid" aria-label="Campo 3×3">
    {
      Array.from({ length: 9 }, (_, i) => (
        <button type="button" class="score-cell" data-cell={i} aria-label={`Carta ${i + 1}`}>
          <span class="score-cell-value" />
          <span class="score-cell-detail" />
        </button>
      ))
    }
  </div>

  <dl class="score-summary">
    <div>
      <dt>Cartas</dt>
      <dd data-sum="cards">0</dd>
    </div>
    <div class="score-keys">
      <dt>
        Fichas do milênio
        <small><img src={key.src} alt="" /> = 1 ponto cada</small>
      </dt>
      <dd class="score-stepper">
        <button type="button" data-keys="-1" aria-label="Menos uma ficha">−</button>
        <input type="tel" inputmode="numeric" pattern="[0-9]*" value="0" aria-label="Fichas do milênio que sobraram" data-keys-input />
        <button type="button" data-keys="1" aria-label="Mais uma ficha">+</button>
      </dd>
    </div>
    <div class="score-total">
      <dt>Total</dt>
      <dd>
        <span data-sum="total">0</span>
        <img src={starchip} alt="pontos" />
      </dd>
    </div>
  </dl>

  <button type="button" class="score-reset">Zerar tudo</button>

  <dialog class="score-modal" aria-labelledby="score-modal-title">
    <form method="dialog">
      <h2 id="score-modal-title">Carta</h2>

      <div class="score-mode" role="radiogroup" aria-label="Como contar">
        <label><input type="radio" name="mode" value="direct" checked /> Pontos</label>
        <label><input type="radio" name="mode" value="per" /> Por</label>
      </div>

      <div class="score-field" data-mode="direct">
        <input type="tel" inputmode="numeric" pattern="[0-9]*" name="points" placeholder="0" aria-label="Pontos da carta" />
      </div>

      <div class="score-field score-per" data-mode="per" hidden>
        <select name="each" aria-label="Pontos por item">
          {Array.from({ length: 10 }, (_, i) => <option value={i + 1}>{i + 1}</option>)}
        </select>
        <span>×</span>
        <input type="tel" inputmode="numeric" pattern="[0-9]*" name="count" placeholder="0" aria-label="Quantidade" />
      </div>

      <p class="score-preview">= <strong data-preview>0</strong> pontos</p>

      <div class="score-actions">
        <button type="button" class="score-clear">Limpar</button>
        <button type="submit" value="save" class="score-save">Salvar</button>
      </div>
    </form>
  </dialog>
</section>

<script>
  type Cell = { mode: "direct"; points: number } | { mode: "per"; each: number; count: number } | null;
  type State = { cells: Cell[]; keys: number };

  const root = document.querySelector<HTMLElement>(".score")!;
  const STORAGE = "combo-duel-score";
  const empty = (): State => ({ cells: Array(9).fill(null), keys: 0 });

  const load = (): State => {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE) ?? "null");
      if (saved?.cells?.length === 9) return saved;
    } catch {}
    return empty();
  };
  const save = () => {
    try {
      localStorage.setItem(STORAGE, JSON.stringify(state));
    } catch {}
  };

  let state = load();
  const toInt = (v: string) => Math.max(0, parseInt(v.replace(/\D/g, ""), 10) || 0);
  const value = (c: Cell) => (!c ? 0 : c.mode === "direct" ? c.points : c.each * c.count);

  const cells = [...root.querySelectorAll<HTMLButtonElement>(".score-cell")];
  const keysInput = root.querySelector<HTMLInputElement>("[data-keys-input]")!;
  const starchip = root.dataset.starchip!;

  const render = () => {
    cells.forEach((btn, i) => {
      const c = state.cells[i];
      btn.classList.toggle("is-set", Boolean(c));
      btn.querySelector(".score-cell-value")!.innerHTML = c
        ? `${value(c)}<img src="${starchip}" alt="">`
        : "+";
      btn.querySelector(".score-cell-detail")!.textContent = c?.mode === "per" ? `${c.each} × ${c.count}` : "";
    });
    const cardsSum = state.cells.reduce((n, c) => n + value(c), 0);
    root.querySelector('[data-sum="cards"]')!.textContent = String(cardsSum);
    root.querySelector('[data-sum="total"]')!.textContent = String(cardsSum + state.keys);
    if (document.activeElement !== keysInput) keysInput.value = String(state.keys);
    save();
  };

  // Fichas do milênio: botões − / + e digitação direta
  root.querySelectorAll<HTMLButtonElement>("[data-keys]").forEach((b) =>
    b.addEventListener("click", () => {
      state.keys = Math.max(0, state.keys + Number(b.dataset.keys));
      render();
    }),
  );
  keysInput.addEventListener("input", () => {
    state.keys = toInt(keysInput.value);
    render();
  });
  keysInput.addEventListener("focus", () => keysInput.select());
  keysInput.addEventListener("blur", render);

  root.querySelector(".score-reset")!.addEventListener("click", () => {
    if (!confirm("Zerar todas as cartas e fichas?")) return;
    state = empty();
    render();
  });

  // Modal
  const modal = root.querySelector<HTMLDialogElement>(".score-modal")!;
  const form = modal.querySelector("form")!;
  const title = modal.querySelector("h2")!;
  const points = form.elements.namedItem("points") as HTMLInputElement;
  const each = form.elements.namedItem("each") as HTMLSelectElement;
  const count = form.elements.namedItem("count") as HTMLInputElement;
  const preview = modal.querySelector("[data-preview]")!;
  const POS = ["superior esquerda", "superior central", "superior direita", "central esquerda", "centro", "central direita", "inferior esquerda", "inferior central", "inferior direita"];
  let current = 0;

  const mode = () => (form.querySelector<HTMLInputElement>('input[name="mode"]:checked')!.value as "direct" | "per");
  const read = (): Cell =>
    mode() === "direct"
      ? points.value.trim() === "" ? null : { mode: "direct", points: toInt(points.value) }
      : count.value.trim() === "" ? null : { mode: "per", each: Number(each.value), count: toInt(count.value) };

  const showMode = (focus = true) => {
    const m = mode();
    form.querySelectorAll<HTMLElement>(".score-field").forEach((f) => (f.hidden = f.dataset.mode !== m));
    if (focus) (m === "direct" ? points : count).focus();
    updatePreview();
  };
  const updatePreview = () => (preview.textContent = String(value(read())));

  cells.forEach((btn, i) =>
    btn.addEventListener("click", () => {
      current = i;
      const c = state.cells[i];
      title.textContent = `Carta ${i + 1} · ${POS[i]}`;
      form.querySelector<HTMLInputElement>(`input[name="mode"][value="${c?.mode ?? "direct"}"]`)!.checked = true;
      points.value = c?.mode === "direct" ? String(c.points) : "";
      each.value = c?.mode === "per" ? String(c.each) : "2";
      count.value = c?.mode === "per" ? String(c.count) : "";
      modal.showModal();
      showMode();
    }),
  );

  form.querySelectorAll('input[name="mode"]').forEach((r) => r.addEventListener("change", () => showMode()));
  [points, count].forEach((el) => el.addEventListener("input", updatePreview));
  each.addEventListener("change", updatePreview);

  form.addEventListener("submit", () => {
    state.cells[current] = read();
    render();
  });
  modal.querySelector(".score-clear")!.addEventListener("click", () => {
    state.cells[current] = null;
    render();
    modal.close();
  });
  // Toque fora do modal fecha sem salvar
  modal.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });

  render();
</script>

<style>
  /* Página só com o auxiliar: esconde o título do Starlight (continua na aba e no menu) */
  :global(main:has(.score) .content-panel:has(h1#_top)) {
    display: none;
  }

  .score {
    --gold: #e9c25a;
    --gold-dark: #5a3d0a;
    max-width: 420px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Campo 3×3: cada casa tem a proporção de uma carta */
  .score-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .score-cell {
    aspect-ratio: 63 / 88;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 0;
    border: 2px dashed var(--sl-color-gray-4);
    border-radius: 10px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-3);
    font: inherit;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.1s ease;
  }

  .score-cell:active {
    transform: scale(0.96);
  }

  .score-cell.is-set {
    border: 3px solid var(--gold);
    background: linear-gradient(#fdf1c4, #efd27e);
    color: #2a1a06;
    box-shadow: 0 0 0 2px var(--gold-dark), 0 4px 10px rgb(0 0 0 / 0.25);
  }

  .score-cell-value {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
  }

  .score-cell-value :global(img) {
    width: 1.6rem;
    height: auto;
  }

  .score-cell-detail {
    min-height: 1.1em;
    font-size: 0.85rem;
    opacity: 0.75;
  }

  /* Resumo: cartas, fichas e total */
  .score-summary {
    margin: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    overflow: hidden;
  }

  .score-summary > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
  }

  .score-summary > div + div {
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .score-summary dt {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-weight: 600;
  }

  .score-summary dt small {
    width: 100%;
    font-weight: 400;
    color: var(--sl-color-gray-3);
  }

  .score-summary dd {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .score-keys dt img {
    width: 22px;
    height: auto;
    vertical-align: -0.35em;
  }

  .score-stepper {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .score-stepper button {
    width: 44px;
    height: 44px;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 10px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font-size: 1.5rem;
    line-height: 1;
    touch-action: manipulation;
  }

  .score-stepper input {
    width: 3.2rem;
    height: 44px;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 10px;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
    text-align: center;
  }

  .score-total {
    background: var(--sl-color-accent-low);
  }

  .score-total dt {
    font-size: 1.25rem;
  }

  .score-total dd {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 2.25rem;
  }

  .score-total dd img {
    width: 2.25rem;
    height: auto;
  }

  .score-reset {
    align-self: center;
    padding: 8px 16px;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 999px;
    background: none;
    color: var(--sl-color-gray-3);
    font: inherit;
    font-size: 0.9rem;
  }

  /* Modal: centralizado no desktop, folha presa embaixo no celular */
  .score-modal {
    width: min(92vw, 360px);
    padding: 0;
    border: 0;
    border-radius: 16px;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.5);
  }

  .score-modal::backdrop {
    background: rgb(0 0 0 / 0.55);
  }

  @media (max-width: 600px) {
    .score-modal {
      width: 100%;
      max-width: 100%;
      margin: auto 0 0;
      border-radius: 16px 16px 0 0;
    }
  }

  .score-modal form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px 18px calc(18px + env(safe-area-inset-bottom));
  }

  .score-modal h2 {
    margin: 0;
    font-size: 1.1rem;
  }

  /* Alternância Pontos / Por */
  .score-mode {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 4px;
    border-radius: 12px;
    background: var(--sl-color-gray-6);
  }

  .score-mode label {
    padding: 10px;
    border-radius: 9px;
    text-align: center;
    font-weight: 600;
    cursor: pointer;
  }

  .score-mode input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .score-mode label:has(input:checked) {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  .score-mode label:has(input:focus-visible) {
    outline: 2px solid var(--sl-color-accent-high);
  }

  .score-field input,
  .score-field select {
    width: 100%;
    height: 64px;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 12px;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
    /* 2rem também evita o zoom automático do iOS (precisa de 16px ou mais) */
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
  }

  .score-per {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .score-per[hidden],
  .score-field[hidden] {
    display: none;
  }

  .score-per select {
    text-align-last: center;
  }

  .score-preview {
    margin: 0;
    text-align: center;
    color: var(--sl-color-gray-3);
  }

  .score-preview strong {
    color: var(--sl-color-white);
    font-size: 1.25rem;
  }

  .score-actions {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 10px;
  }

  .score-actions button {
    height: 52px;
    border-radius: 12px;
    font: inherit;
    font-weight: 700;
    touch-action: manipulation;
  }

  .score-clear {
    border: 1px solid var(--sl-color-gray-4);
    background: none;
    color: var(--sl-color-white);
  }

  .score-save {
    border: 0;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
</style>
